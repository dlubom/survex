+wxSize wxTextCtrl::DoGetSizeFromTextSize(int xlen, int ylen) const
+{
+    // Generic composite controls (notably wxSpinCtrl) use this to fit their
+    // formatted range. The base implementation returns (-1, -1), which
+    // otherwise leaves only the spin arrows and a fallback-width text box.
+    if (ylen < 0)
+    {
+        ylen = GetCharHeight();
+        if (HasFlag(wxTE_MULTILINE))
+            ylen *= wxMax(2, wxMin(GetNumberOfLines(), 10));
+    }
+
+    int width = wxMax(0, xlen) + 2;
+    int height = wxMax(1, ylen) + 2;
+    if (WasmGetDomId())
+        wxDomTextCtrlSizeFromText(WasmGetDomId(), xlen, ylen, &width, &height);
+    return wxSize(width, height);
+}
